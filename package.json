{
  "name": "stableflow-backend",
  "version": "0.0.1",
  "description": "StableFlow Backend Application",
  "author": "",
  "private": true,
  "scripts": {
    "prebuild": "npx rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "NODE_ENV=development nodemon",
    "debug": "NODE_ENV=development nodemon --config nodemon-debug.json",
    "prod": "node dist/main",
    "worker": "NODE_ENV=development WORKER_ONLY=true nodemon",
    "worker:prod": "NODE_ENV=production WORKER_ONLY=true node dist/main.js",
    "hybrid": "NODE_ENV=development nodemon",
    "hybrid:prod": "NODE_ENV=production node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch --verbose --passWithNoTests --detectOpenHandles --no-cache",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:run": "NODE_ENV=development yarn typeorm migration:run -d src/config/typeorm.config.ts",
    "migration:revert": "yarn typeorm migration:revert -d src/config/typeorm.config.ts",
    "migration:generate": "yarn typeorm migration:generate -d src/config/typeorm.config.ts -n",
    "migration:generate:auto": "NODE_ENV=development yarn typeorm migration:generate -d src/config/typeorm.config.ts -n AutoGenMigration_$(date +%Y%m%d%H%M%S) src/migrations/auto-generated",
    "migration:cleanup:auto": "find src/migrations -name 'AutoGenMigration_*.ts' -type f -delete"
  },
  "dependencies": {
    "@liaoliaots/nestjs-redis": "^9.0.5",
    "@nestjs/axios": "^2.0.0",
    "@nestjs/bull": "^11.0.2",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^2.3.1",
    "@nestjs/core": "^9.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/schedule": "^3.0.0",
    "@nestjs/swagger": "^6.2.1",
    "@nestjs/typeorm": "^9.0.1",
    "axios": "^1.3.4",
    "bull": "^4.16.5",
    "bullmq": "^5.43.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.6.0",
    "nodemailer": "^6.10.0",
    "pg": "^8.10.0",
    "redlock": "^5.0.0-beta.2",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.5.5",
    "swagger-ui-express": "^4.6.2",
    "typeorm": "^0.3.12",
    "uuid": "^11.1.0",
    "viem": "^2.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/express": "^4.17.13",
    "@types/jest": "^28.1.4",
    "@types/node": "^18.0.3",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.30.5",
    "@typescript-eslint/parser": "^5.30.5",
    "concurrently": "^8.2.2",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^28.1.2",
    "jest-watch-typeahead": "^2.2.2",
    "node-notifier": "^10.0.1",
    "nodemon": "^3.1.0",
    "prettier": "^2.7.1",
    "source-map-support": "^0.5.21",
    "supertest": "^6.2.4",
    "ts-jest": "^28.0.5",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.8.2",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
